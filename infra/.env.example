# Copy to infra/.env (gitignored) and fill in. Never commit the real file.
# Load it with:  set -a; source .env; set +a

# Render
RENDER_API_KEY=
RENDER_OWNER_ID=

# MongoDB Atlas (API key pair, not your login)
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=

# Terraform variables
TF_VAR_atlas_project_id=
TF_VAR_atlas_backing_provider=   # AWS, GCP or AZURE, as shown on the cluster
TF_VAR_atlas_region=             # e.g. EU_NORTH_1, must match the cluster exactly
TF_VAR_admin_url=
TF_VAR_google_client_id=
TF_VAR_google_client_secret=
